# Glassbox — copy this file to .env.local and fill it in.
#
#   cp .env.example .env.local
#
# .env.local is gitignored. Never commit a delegate key.
# The app never crashes on a missing value: every route still renders and the
# missing variable is named on screen with the exact remedy.

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# The shared account object id, from https://memory.walrus.xyz
# This is a PUBLIC object identifier. It is not a secret and is safe to put in
# a README or a chat message. Everyone on the team uses the same one.
MEMWAL_ACCOUNT_ID=

# YOUR delegate private key: 64 hexadecimal characters, the private one.
# One key per person, per machine. Never reuse someone else's, and never commit
# this. It is equivalent to an API key: anyone holding it can read and write
# every memory on the account.
MEMWAL_PRIVATE_KEY=

# Who this machine records as. Lowercase letters, numbers and hyphens, at most
# 32 characters. Use the form firstname-machine so two machines belonging to one
# person are distinguishable.
# Writing is disabled without it; reading still works.
GLASSBOX_AUTHOR=

# ---------------------------------------------------------------------------
# OPTIONAL — every one of these has a working default
# ---------------------------------------------------------------------------

# The relayer. Defaults to the value below.
# MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# Which namespaces the feed sweeps, comma-separated.
# Namespaces are exact-match and CASE-SENSITIVE: "team" and "Team" are two
# permanently separate memories. Slashes carry no hierarchy, and there is no
# search across namespaces.
# GLASSBOX_NAMESPACES=default,team

# What the capture box opens on. "mine" or "team". Defaults to mine.
#
# mine is the safe default deliberately: storage is append-only, so an
# accidental TEAM write cannot be unpublished. Set this to team only if your
# team genuinely wants shared-by-default.
# GLASSBOX_DEFAULT_SCOPE=mine

# Attachment storage. Public endpoints, no credential and no wallet required.
# WALRUS_PUBLISHER=https://publisher.walrus-testnet.walrus.space
# WALRUS_AGGREGATOR=https://aggregator.walrus-testnet.walrus.space

# The ACCOUNT OWNER address — not your delegate address.
# Only needed if automatic owner discovery fails. Without it the app runs in
# TEXT-ONLY MODE: every memory feature works, but byte sizes, expiry dates,
# storage status and the credential list are not shown. Find it at
# https://memory.walrus.xyz
# MEMWAL_OWNER_ADDRESS=
